<?xml version="1.0"?>
<launch>
    <arg name="quad_name" default="adr"/>
    <arg name="rviz" default="true"/>

    <!-- GUI -->
    <node name="agiros_gui" pkg="rqt_gui" type="rqt_gui"
          args="-s agiros_gui.basic_flight.BasicFlight --args
        --quad_name $(arg quad_name)" output="screen"/>

    <group if="$(arg rviz)">
        <node pkg="rviz" type="rviz" name="viz_face" args="-d $(find msp_ros)/rviz/$(arg quad_name).rviz" ns="$(arg quad_name)"/>
    </group>

</launch>

